{
  "expo": {
    "name": "HB Logistics",
    "slug": "homebasket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/exhome_logo.png",
    "scheme": "homebasketdelivery",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.homebasket.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HB Logistics needs your location to assign nearby delivery jobs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "HB Logistics needs your location to assign nearby delivery jobs even in the background."
      }
    },
    "android": {
      "package": "com.homebasket.delivery",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA1Kj7UYcHrOCsN2R4U-MWGijJj_DPLpH8"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#006C49",
        "foregroundImage": "./assets/images/exhome_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "AIzaSyA1Kj7UYcHrOCsN2R4U-MWGijJj_DPLpH8"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/exhome_logo.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/exhome_logo.png",
          "color": "#00C896",
          "sounds": [
            "./assets/sounds/order_ring.wav",
            "./assets/sounds/classic_bell.mp3",
            "./assets/sounds/alarm_ring.mp3",
            "./assets/sounds/mysterious.mp3",
            "./assets/sounds/siren_alert.mp3",
            "./assets/sounds/techno_alert.mp3"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HB Logistics needs your location to assign nearby delivery jobs."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}